# Docker Compose overrides.
#
# Base configuration comes from .env.
# This file only changes addresses that must resolve through the
# Docker Compose networks instead of localhost.

# --- postgres --------------------------------------------------------------
POSTGRES_DSN=postgres://identity_app:devpassword@data-postgres:5432/identity?sslmode=disable

# --- kafka -----------------------------------------------------------------
KAFKA_BROKERS=messaging-kafka:9092

# --- opentelemetry ---------------------------------------------------------
# The API container reaches the OTel Collector through the shared
# observability Docker network using the collector service name.

OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-otel-collector:4317